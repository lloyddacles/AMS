PORT=4000
JWT_SECRET=change-this-secret-in-production
CLIENT_ORIGIN=http://localhost:5173

# Timezone used to interpret event start/end times and classify check-ins
# (early / on-time / late). Defaults to Asia/Manila when unset.
APP_TIMEZONE=Asia/Manila

# Production uses a hosted SQLite (libSQL/Turso). When these are unset, the
# server falls back to a local file at server/data/attendance.sqlite.
# Set these in your Vercel (or hosting) environment:
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
